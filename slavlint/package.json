{
  "name": "slavlint",
  "version": "0.1.0",
  "description": "Lints Czech and Polish i18n locale files for plural, grammar and typography mistakes that AI agents typically make.",
  "type": "module",
  "bin": {
    "slavlint": "dist/cli.js",
    "slavlint-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    ".cursor/rules"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/mcp.js",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "mcp": "node dist/mcp.js",
    "lint:demo": "node dist/cli.js ../demo/locales",
    "lint:fixtures": "node dist/cli.js fixtures"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "i18n",
    "i18next",
    "czech",
    "polish",
    "lint",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "picocolors": "^1.1.1",
    "vokativ": "^1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "i18next": "^26.4.2",
    "typescript": "^5.9.3"
  }
}
